{
  "name": "bastet-console",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/bastet_console/wrangler.json",
    "deploy": "wrangler deploy --config dist/bastet_console/wrangler.json",
    "deploy:preview": "wrangler versions upload --config dist/bastet_console/wrangler.json",
    "typecheck": "tsc --noEmit",
    "cf:typegen": "wrangler types worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:worker": "node --test tests/worker.test.mjs",
    "test:migration": "node --import tsx --test tests/export-supabase.test.mjs tests/import-d1.test.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit/",
    "test:unit:security": "jest tests/unit/security/",
    "test:integration": "jest tests/integration/",
    "test:integration:security": "jest tests/integration/security/",
    "test:e2e": "playwright test",
    "test:e2e:security": "playwright test tests/e2e/security/",
    "test:security": "node scripts/security-test.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:ci": "npm run test:unit:security && npm run test:e2e:security",
    "security:audit": "npm audit --audit-level moderate",
    "security:fix": "npm audit fix",
    "security:scan": "npm run security:audit && npm run test:security",
    "security:socket": "npx @socketsecurity/cli scan",
    "security:deps": "npm run security:audit && npm run security:socket",
    "security:check": "npm run security:deps && npm run test:security",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/bastet_console/wrangler.json",
    "deploy:vinext": "wrangler deploy --config dist/bastet_console/wrangler.json"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.1",
    "@vinext/cloudflare": "1.0.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.0",
    "google-auth-library": "^10.4.0",
    "jsonwebtoken": "^9.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vinext": "1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.3",
    "@cloudflare/workers-types": "5.20260930.2",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/hapi__shot": "^4.1.6",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.19",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "miniflare": "5.20260930.0-alpha",
    "msw": "^2.11.5",
    "next": "16.3.8",
    "playwright": "^1.56.0",
    "postcss": "^8.4.38",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.4",
    "tsx": "4.23.15",
    "typescript": "^5.4.5",
    "vite": "8.3.1",
    "wrangler": "4.145.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  }
}
